NODE_ENV="development"

# HTTP server
HTTP_PORT=4000
HTTP_HOST="http://localhost:4000"
HTTP_CORS="http://localhost:3000"

# Cookies
COOKIES_DOMAIN="localhost" # or production domain like ".microcinema.com"
COOKIES_SECRET="your_secret_key"

# Passport
PASSPORT_SECRET_KEY="your_secret_key"

# gRPC clients
AUTH_GRPC_URL="localhost:50051"
